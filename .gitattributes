* text=auto

# Python source: always LF
*.py   text eol=lf

# YAML configs
*.yaml text eol=lf
*.yml  text eol=lf

# Documentation
*.md   text eol=lf

# LaTeX manuscript
*.tex  text eol=lf

# Config and metadata
*.toml text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.html text eol=lf diff=html

# Meta-files
.gitignore     text eol=lf
.gitattributes text eol=lf
LICENSE        text eol=lf

# Batch files: keep CRLF
*.bat  text eol=crlf

# Binary files — no conversion
*.png  binary
*.jpg  binary
*.pt   binary
*.parquet binary
